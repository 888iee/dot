    "hyprland/workspaces",
    "hyprland/submap",
    "hyprland/window",
  ],
  "modules-right": [
    "network",
    "custom/vpn",
    "cpu",
    // "memory",
    "disk",
    "pulseaudio",
    "bluetooth",
    "hyprland/language",
    "tray",
    "battery",
    "clock"
  ],
},
